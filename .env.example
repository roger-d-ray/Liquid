# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Trading mode guardrails.
# Default without these variables is paper mode.
# To trade with real funds:
# 1. In Co-Invest/Liquid, switch the connected account back to live trading.
# 2. Verify the account status in the assistant.
# 3. Set both variables below.
TRADING_MODE=paper
LIVE_TRADING_ALLOWED=false
# A bar is final only after close_time plus this venue-time grace period.
OHLC_CLOSE_GRACE_SECONDS=2

# ExecutionInstrumentResolver fail-closed thresholds.
# Maximum age of the execution venue quote and maximum allowed divergence
# between the signal price and the executable bid/ask (or last-price fallback).
EXECUTION_DATA_MAX_AGE_SECONDS=30
MAX_EXECUTION_DISLOCATION_BPS=25
# Co-Invest documents a $15 minimum collateral requirement. Higher values are
# allowed; code never permits this setting to weaken the $15 platform floor.
COINVEST_MINIMUM_COLLATERAL_USD=15
